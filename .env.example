# ============================================================================
# LANDING-SGPT — (.env.example)
# Stratum Sovereign Consumer Pattern (v2.0)
# ============================================================================

# Tenant / Organization Slug
TENANT_ORG=sgpt

# Zona Horaria
TZ=America/Bogota

# Red compartida o red interna de la plataforma Stratum
# - Producción DMZ (perímetro compartido): stratum_dmz
# - Producción Isla Inquilino (Tier 3 aislado): stratum_sgpt_internal
STRATUM_NETWORK=stratum_dmz
STRATUM_DMZ_NETWORK=stratum_dmz
