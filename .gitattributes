# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# Force LF on scripts, configs, and web assets
*.sh text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.conf text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.svg text eol=lf
*.md text eol=lf

# Binary assets
*.png binary
*.ico binary
*.pdf binary
